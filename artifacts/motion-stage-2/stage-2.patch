+        // A delayed element remains visible until its actual animation starts.
+        if (!element.isConnected || document.hidden) return;
+        element.style.willChange = "transform, opacity";
+        animation = element.animate([
+          { transform: `translateY(${distance}px) rotateX(${rotation}deg)`, opacity: 0 },
+          { transform: "none", opacity: 1 },
+        ], { duration: tokens.duration, easing: tokens.easing, fill: "none" });
