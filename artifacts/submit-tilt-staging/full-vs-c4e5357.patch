+[data-photo-frame] > img { position: static; display: block; width: 100%; height: auto; object-fit: contain; }
+[data-photo-frame]::after { content: ""; position: absolute; inset: 0; pointer-events: none; background: radial-gradient(ellipse at var(--photo-x,50%) var(--photo-y,50%),rgba(198,255,250,.32),transparent 62%); opacity: 0; transition: opacity 600ms; }
