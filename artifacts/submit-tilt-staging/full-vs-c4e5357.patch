+.about-network-image, .about-thumbnail { background: #e8eded; }
+@media (max-width: 900px) {
+  .cinematic-hero-background { object-fit: contain; object-position: center bottom; }
+}
+
+/* Photograph-only frames follow native source ratios; logos and the stationary
+   homepage background have their own sizing rules. */
