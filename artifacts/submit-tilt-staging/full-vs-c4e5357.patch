+.image-feedback-layer { position: absolute; z-index: 4; pointer-events: none; user-select: none; }
+.image-feedback-ripple { width: 116px; height: 116px; transform: translate(-50%,-50%); border-radius: 50%; border: 3px solid #42e0cf; background: radial-gradient(circle,rgba(63,213,197,.55),rgba(34,163,169,.25) 58%,transparent 70%); box-shadow: 0 0 0 2px rgba(239,255,255,.8); }
+/* Match the replaced orbital area's height so Quote text and form stay put. */
+.quote-media { position: relative; height: 330px; min-width: 0; display: grid; place-items: center; overflow: hidden; isolation: isolate; contain: layout paint; }
+.quote-photo { width: min(423px,calc(100% - 48px)); border-radius: 8px; box-shadow: 0 12px 28px #0c27372b; }
+.quote-bubble-canvas, .quote-bubble-fallback { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 2; }
+.quote-bubble-fallback i { position: absolute; width: 40px; aspect-ratio: 1; border-radius: 50%; border: 1px solid #a7d4d4; background: radial-gradient(circle at 28% 24%,#ffffffed,#abd9d35e 32%,#267e8552 73%,#d6f4e2ab); box-shadow: inset -4px -5px 9px #194f5c26,0 5px 12px #194f5c14; }
+.quote-bubble-fallback i:nth-child(1) { left: 4%; top: 18%; }
