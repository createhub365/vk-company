+.process-depth {
+  --process-active-z: 60px;
+  --process-inactive-z: -30px;
+  --process-inactive-opacity: .55;
+  position: relative;
+  margin-top: 58px;
+}
+.process-depth .process-list {
+  margin-top: 0;
+  grid-template-columns: repeat(4, minmax(0, 1fr));
+  /* Each step has a local vanishing point: Z must not push end columns outside
+     the shell, or send a long mobile sequence toward a distant shared origin. */
+  transform-style: flat;
+}
+.process-depth .process-list > li {
+  transform-origin: center;
+  /* Local CSS perspective preserves the requested Z without lateral drift. */
+  transform: none;
+  opacity: 1;
+  --process-emphasis: 0;
+}
+.process-depth .process-list > li > span { position: relative; isolation: isolate; }
+.process-depth .process-list > li > span::before {
+  content: "";
+  position: absolute;
+  width: 44px;
+  height: 32px;
+  left: -14px;
+  top: 50%;
+  transform: translateY(-50%);
+  z-index: -1;
+  pointer-events: none;
+  background: radial-gradient(ellipse, rgb(36 158 169 / .32), transparent 70%);
+  opacity: var(--process-emphasis);
+}
+.process-connector {
+  position: absolute;
+  inset: 0 0 auto;
+  width: 100%;
+  height: 2px;
+  overflow: visible;
+  pointer-events: none;
+}
+.process-connector line {
+  fill: none;
+  stroke: var(--teal);
+  stroke-width: 2;
+  stroke-dasharray: 1;
+  stroke-dashoffset: 0;
+}
+.process-line-vertical { display: none; }
+@media (width >= 768px) {
+  .process-depth .process-list > li { border-top: 0; }
+  .process-depth .process-list > li + li { border-left-color: #d0d9db; }
+}
+@media (width < 768px) {
+  .process-depth .process-list { grid-template-columns: 1fr; }
+  .process-depth .process-list > li { border-left: 0; padding: 27px 0; min-height: 0; }
+  .process-depth .process-list > li + li { border-top: 1px solid #d0d9db; }
+  .process-depth .process-connector { inset: 0 auto 0 -8px; width: 2px; height: 100%; }
+  .process-depth .process-line-horizontal { display: none; }
+  .process-depth .process-line-vertical { display: initial; }
+}
+@media (width < 768px) {
+  .process-depth { --process-active-z: 30px; --process-inactive-z: -15px; }
+}
+@media (prefers-reduced-motion: reduce) {
+  .process-depth .process-list { perspective: none !important; }
+  .process-depth .process-list > li { transform: none !important; opacity: 1 !important; will-change: auto !important; }
+  .process-depth .process-list > li > span::before { opacity: 0 !important; }
+  .process-depth .process-connector line { stroke-dashoffset: 0 !important; }
+}
