+/* Existing editorial columns, spacing, image frames and responsive order remain. */
+.editorial-motion { --editorial-text-z: 12px; }
+.editorial-motion .editorial-media { min-width: 0; transform-style: flat; }
+.editorial-motion .editorial-grid-reverse > .editorial-media { order: 2; }
