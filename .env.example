# Supabase is used by admin/tracking, NOT by quote/contact email submissions.
# Public Supabase project values (safe for browser use)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Never prefix this with NEXT_PUBLIC or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Optional confirmed production origin, used for canonical metadata and strict origin checks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Legacy outbox setting for existing database workflows; unused by quote/contact.
NOTIFICATION_TRANSPORT=outbox

# Direct quote/contact SMTP (server only; all six settings are required).
# Use the SMTP provider's host, authenticated credentials, and approved From.
# Port 465: SMTP_SECURE=true. Port 587: SMTP_SECURE=false (mandatory STARTTLS).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
NOTIFICATION_FROM_EMAIL=

# Enable ONLY behind a trusted proxy that overwrites X-Forwarded-For with one
# verified client IP and blocks direct origin access. Otherwise limits are shared.
ENQUIRY_TRUST_PROXY=false
